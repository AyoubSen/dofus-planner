{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3001",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "dofusdb:smoke": "node scripts/dofusdb-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "powershell -ExecutionPolicy Bypass -File ./scripts/dofus-capture.ps1",
    "capture:calibrate": "powershell -ExecutionPolicy Bypass -File ./scripts/dofus-capture.ps1 -Calibrate",
    "corpus:grade": "node scripts/grade-corpus.mjs",
    "corpus:gate": "node scripts/grade-corpus.mjs --gate",
    "atlas:build": "node scripts/build-atlas.mjs",
    "atlas:ingest": "node scripts/ingest-page.mjs",
    "data:subzones": "node scripts/fetch-subzone-geo.mjs",
    "data:monster-ids": "node scripts/fetch-monster-ids.mjs"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.9",
    "@nuxt/fonts": "0.11.4",
    "@nuxtjs/i18n": "^10.2.1",
    "@vueuse/nuxt": "13.5.0",
    "nuxt": "^4.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "uplot": "^1.6.32",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
